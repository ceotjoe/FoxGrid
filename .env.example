# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=foxgrid
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=foxgrid
REDIS_PASSWORD=change-me-redis

# At least 32 characters; the API refuses to start with a "change-me" value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FOXGRID_JWT_SECRET=change-me-jwt-secret-at-least-32-chars
FOXGRID_JWT_TTL_HOURS=72
# Restrict CORS to your web origin in production (JSON list).
# FOXGRID_CORS_ORIGINS=["https://foxgrid.example.org"]
# Expose /docs and /openapi.json (off by default).
# FOXGRID_ENABLE_DOCS=true
# Missions created per client address and minute (0 = off).
# FOXGRID_RATE_MISSION_PER_MIN=5

# Host port mappings
FOXGRID_API_PORT=8000
# API, DB and Redis listen on 127.0.0.1 only; set 0.0.0.0 for LAN tests, otherwise use the proxy.
# FOXGRID_API_BIND=127.0.0.1
FOXGRID_DB_PORT=5432
FOXGRID_REDIS_PORT=6379

# Override on arm64 hosts if you prefer a native PostGIS image.
FOXGRID_POSTGIS_IMAGE=postgis/postgis:16-3.4

# Push notifications (optional). Without these the server only logs pushes.
# Needs a Firebase project with a service-account key (Cloud Messaging API v1).
# FOXGRID_FCM_PROJECT_ID=my-firebase-project
# FOXGRID_FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json

# MQTT (optional, docker compose --profile mqtt up -d). Broker login for stations, the relay
# hook and the ingest service; each sensor also has its own API key.
FOXGRID_MQTT_USERNAME=foxgrid
FOXGRID_MQTT_PASSWORD=change-me-mqtt
FOXGRID_MQTT_PORT=1883
